rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Única cuenta con permiso de escritura (Firebase → Authentication)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'u47vBmzPBdPj7MjJCK3z109VbNq1';
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Todo lo demás queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
